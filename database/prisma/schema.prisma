// Kickstead database schema.
//
// Conventions:
// - Money is stored as integer paise (INR minor units).
// - Tables and columns are snake_case in PostgreSQL; models are PascalCase/camelCase in Prisma.
// - Invariants Prisma cannot express (CHECK constraints, partial unique indexes) live in the
//   SQL migration files and are listed in the comments of each model.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PLACED
  PAID
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  PAYMENT_FAILED
  PAYMENT_CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum InventoryReason {
  ORDER_RESERVED // stock taken when an order is PLACED
  ORDER_RELEASED // stock returned after a failed or cancelled payment
  ORDER_CANCELLED // stock returned after an order is cancelled
  ADMIN_ADJUSTMENT // manual stock change by an admin
  SEED // initial stock from seed data
}

// One row per person. `id` equals the Supabase Auth user id (auth.users.id),
// so it has no default: the backend inserts it on the user's first authenticated request.
model User {
  id        String   @id @db.Uuid
  email     String   @unique @db.VarChar(255)
  name      String   @db.VarChar(120)
  role      Role     @default(CUSTOMER)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  addresses          Address[]
  cart               Cart?
  orders             Order[]
  inventoryMovements InventoryMovement[]
  auditLogs          AuditLog[]

  @@map("users")
}

model Category {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(120)
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  products Product[]

  @@map("categories")
}

// CHECK: price_paise >= 0, stock_quantity >= 0
model Product {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId    String   @map("category_id") @db.Uuid
  name          String   @db.VarChar(200)
  slug          String   @unique @db.VarChar(220)
  brand         String   @db.VarChar(100)
  description   String
  pricePaise    Int      @map("price_paise")
  stockQuantity Int      @default(0) @map("stock_quantity")
  imageUrl      String?  @map("image_url")
  isActive      Boolean  @default(true) @map("is_active")
  isFeatured    Boolean  @default(false) @map("is_featured")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  category           Category            @relation(fields: [categoryId], references: [id])
  cartItems          CartItem[]
  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]

  @@index([categoryId])
  @@index([isActive, createdAt])
  @@index([isActive, pricePaise])
  @@index([stockQuantity])
  @@map("products")
}

// PARTIAL UNIQUE: at most one default address per user
model Address {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  fullName   String   @map("full_name") @db.VarChar(120)
  phone      String   @db.VarChar(30)
  line1      String   @db.VarChar(200)
  line2      String?  @db.VarChar(200)
  city       String   @db.VarChar(100)
  state      String   @db.VarChar(100)
  postalCode String   @map("postal_code") @db.VarChar(20)
  country    String   @default("India") @db.VarChar(80)
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

model Cart {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

// CHECK: quantity > 0
model CartItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
  @@index([productId])
  @@map("cart_items")
}

// CHECK: all *_paise >= 0, total = subtotal - discount + tax + shipping
// PARTIAL UNIQUE: at most one PLACED order per user (prevents double stock reservation)
// UNIQUE(user_id, idempotency_key): duplicate checkout protection
model Order {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderNumber     String      @unique @map("order_number") @db.VarChar(30)
  userId          String      @map("user_id") @db.Uuid
  status          OrderStatus @default(PLACED)
  addressSnapshot Json        @map("address_snapshot")
  subtotalPaise   Int         @map("subtotal_paise")
  discountPaise   Int         @default(0) @map("discount_paise")
  taxPaise        Int         @default(0) @map("tax_paise")
  shippingPaise   Int         @default(0) @map("shipping_paise")
  totalPaise      Int         @map("total_paise")
  currency        String      @default("INR") @db.Char(3)
  idempotencyKey  String      @map("idempotency_key") @db.VarChar(120)
  cancelledAt     DateTime?   @map("cancelled_at") @db.Timestamptz(6)
  cancelReason    String?     @map("cancel_reason") @db.VarChar(300)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  user               User                @relation(fields: [userId], references: [id])
  items              OrderItem[]
  payment            Payment?
  inventoryMovements InventoryMovement[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@map("orders")
}

// Snapshots keep historical orders correct after catalogue edits.
// CHECK: unit_price_paise >= 0, quantity > 0, line_total_paise = unit_price_paise * quantity
model OrderItem {
  id                   String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId              String  @map("order_id") @db.Uuid
  productId            String? @map("product_id") @db.Uuid
  productNameSnapshot  String  @map("product_name_snapshot") @db.VarChar(200)
  productImageSnapshot String? @map("product_image_snapshot")
  unitPricePaise       Int     @map("unit_price_paise")
  quantity             Int
  lineTotalPaise       Int     @map("line_total_paise")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// One simulated payment per order. No card data is ever stored.
// CHECK: amount_paise >= 0
model Payment {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId           String        @unique @map("order_id") @db.Uuid
  status            PaymentStatus @default(PENDING)
  amountPaise       Int           @map("amount_paise")
  provider          String        @default("SIMULATED") @db.VarChar(30)
  providerReference String?       @unique @map("provider_reference") @db.VarChar(120)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("payments")
}

// Append-only ledger of stock changes.
// CHECK: quantity_change <> 0, stock_after >= 0
model InventoryMovement {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId      String          @map("product_id") @db.Uuid
  quantityChange Int             @map("quantity_change")
  stockAfter     Int             @map("stock_after")
  reason         InventoryReason
  orderId        String?         @map("order_id") @db.Uuid
  actorUserId    String?         @map("actor_user_id") @db.Uuid
  note           String?         @db.VarChar(300)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id])
  order   Order?  @relation(fields: [orderId], references: [id])
  actor   User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([orderId])
  @@map("inventory_movements")
}

// Append-only record of material business actions. Never stores secrets.
model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(80)
  entityType  String   @map("entity_type") @db.VarChar(50)
  entityId    String?  @map("entity_id") @db.Uuid
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorUserId])
  @@map("audit_logs")
}
