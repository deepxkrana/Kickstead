NODE_ENV=development
PORT=4000
# Same pooled connection string as database/.env DATABASE_URL.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Comma-separated list of allowed browser origins.
CLIENT_URL=http://localhost:5173
# Used to verify login tokens via Supabase's public signing keys (JWKS). No secret needed.
SUPABASE_URL="https://<project-ref>.supabase.co"

# Emails that get the ADMIN role on first sign-in (comma-separated). Everyone else is CUSTOMER.
ADMIN_EMAILS=you@example.com,admin@kickstead.dev
